# FITNESS 1.0 — Environment Configuration Template
# Copy this file to .env or enter these values directly in the app's Settings screen

# Supabase Project Credentials (project: Fitness-season-1)
# NOTE: Use only your public project URL and public 'anon' key.
# NEVER commit your service_role secret key!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Table and Sync Config
SUPABASE_PROGRESS_TABLE=season10_progress
SUPABASE_SESSION_KEY=season10-session
